# Copy this file to .env and fill in details to enable REAL SMS + Email.
# Without these, the app runs in demo mode (SMS/Email are logged to console).

# ── Twilio SMS ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
# Trial accounts only allow predefined template SMS. Options:
# sms_2fa, sms_appointment_reminders, sms_order_confirmation, sms_delivery_updates,
# sms_customer_support, sms_marketing_promotions, sms_event_notifications,
# sms_account_alerts, sms_feedback_surveys, sms_internal_alerts
# Leave empty on upgraded accounts to send custom message bodies.
TWILIO_TRIAL_TEMPLATE=sms_order_confirmation

# ── SMTP Email (e.g. Gmail app password) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=procurement@kisansetu.gov.in

# ── Supabase / Postgres (optional; removes need for SQLite) ──
# Copy your pooled connection string from Supabase → Project Settings → Database.
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# ── Session secret (change in production) ─────────────────
SESSION_SECRET=replace-with-a-long-random-string